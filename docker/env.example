# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb+srv://dummy:k28dKa0rtbMs9@cluster0.qorsvtn.mongodb.net/agata

# JWT Configuration (if needed later)
OPENAI_API_KEY=123
# Data fetching settings
DATA_FETCH_INTERVAL=3600000  # 1 hour in milliseconds
DATA_RETENTION_DAYS=30

SOTRA_API_KEY=tajne...
BAMBORAK_API_BASE_URL
# SIP (Asterisk) bridge
# WebSocket endpoint exposed by sip-client/docker-compose.yml (host port 3004 -> container 3000)
SIP_CLIENT_WS_URL=ws://localhost:3004

# Optional: play a greeting once when a phone call session starts.
# Generated via Bamborak TTS and sent to the SIP client as 8kHz PCM16.
SIP_WELCOME_TEXT=

# While the server is playing audio to the phone, ignore user transcripts
# unless this word/phrase is spoken. When spoken, playback is interrupted.
SIP_PLAYBACK_INTERRUPT_WORD=Dźakuju

# Speech-to-text (Vosk)
VOSK_SERVER_URL=http://localhost:2700