# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_USERNAME=dummy
MONGODB_PASSWORD=your-password
MONGODB_HOST=localhost:27017
MONGODB_DATABASE=agata

# JWT Configuration (if needed later)
OPENAI_API_KEY=123
OPENAI_CHAT_MODEL=gpt-5-mini
LLM_CHAT_BACKEND=openai

Ollama chat (set LLM_CHAT_BACKEND=ollama)
LLM_CHAT_ENDPOINT=http://localhost:11434
LLM_CHAT_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=60

SOTRA_API_KEY=tajne...
SOTRA_URL=https://dein-sotra-service
SOTRA_TIMEOUT_SECONDS=30
BAMBORAK_API_BASE_URL
# SIP (Asterisk) bridge
# WebSocket endpoint exposed by sip-client/docker-compose.yml (host port 3004 -> container 3000)
SIP_CLIENT_WS_URL=ws://localhost:3004

# Optional: play a greeting once when a phone call session starts.
# Generated via Bamborak TTS and sent to the SIP client as 8kHz PCM16.
SIP_WELCOME_TEXT=

# While the server is playing audio to the phone, ignore user transcripts
# unless this word/phrase is spoken. When spoken, playback is interrupted.
SIP_PLAYBACK_INTERRUPT_WORD=Dźakuju

# Speech-to-text (Vosk)
VOSK_SERVER_URL=http://localhost:2700

RAG_SERVER_URL=http://localhost:8000

# Set to true to enable detailed chat pipeline timing logs
CHAT_TIMING_ENABLED=false

# SIP (Asterisk) bridge
# WebSocket endpoint exposed by sip-client/docker-compose.yml (host port 3004 -> container 3000)
SIP_CLIENT_WS_URL=ws://localhost:3004
SIP_PROTOCOL_DEBUG=false
VOSK_SEND_TIMESTAMP=false
VOSK_DUMP_TX_CHUNKS=false