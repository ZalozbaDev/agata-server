# Server Configuration
PORT=3000
NODE_ENV=development

SIP_ENABLED=true

# Database Configuration
# Option A (recommended for MongoDB Atlas): full connection string
# MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/test
#
# Option B: split vars (local MongoDB or Atlas)
MONGODB_USERNAME=dummy
MONGODB_PASSWORD=your-password
# From Docker use host.docker.internal (not localhost) to reach MongoDB on the host
MONGODB_HOST=host.docker.internal:27017

# JWT Configuration (if needed later)
OPENAI_API_KEY=123
OPENAI_CHAT_MODEL=gpt-5-mini
LLM_CHAT_BACKEND=openai

Ollama chat (set LLM_CHAT_BACKEND=ollama)
LLM_CHAT_ENDPOINT=http://host.docker.internal:11434
LLM_CHAT_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=60

SOTRA_API_KEY=tajne...
SOTRA_URL=https://dein-sotra-service
SOTRA_TIMEOUT_SECONDS=30
SOTRA_LOCAL_BACKEND=false
BAMBORAK_API_BASE_URL
# SIP (Asterisk) bridge
# WebSocket endpoint exposed by sip-client/docker-compose.yml (host port 3004 -> container 3000)
SIP_CLIENT_WS_URL=ws://host.docker.internal:3004

# Optional: play a greeting once when a phone call session starts.
# Generated via Bamborak TTS and sent to the SIP client as 8kHz PCM16.
SIP_WELCOME_TEXT=

# While the server is playing audio to the phone, ignore user transcripts
# unless this word/phrase is spoken. When spoken, playback is interrupted.
SIP_PLAYBACK_INTERRUPT_WORD=Dźakuju

# Speech-to-text (Vosk)
VOSK_SERVER_URL=http://host.docker.internal:2700

RAG_SERVER_URL=http://host.docker.internal:8000

# SIP (Asterisk) bridge
# WebSocket endpoint exposed by sip-client/docker-compose.yml (host port 3004 -> container 3000)
SIP_CLIENT_WS_URL=ws://localhost:3004

# Chat pipeline logs: none | rag | all
# none — no chat logs (default)
# rag  — compact: persona, question, RAG hits with match %, sources sent to AI, answer
# all  — full timing/provider logs plus the compact RAG summary
CHAT_LOG_MODE=none
# Legacy alias: CHAT_TIMING_ENABLED=true is treated as CHAT_LOG_MODE=all
# CHAT_TIMING_ENABLED=false

SIP_PROTOCOL_DEBUG=false
VOSK_SEND_TIMESTAMP=false
VOSK_DUMP_TX_CHUNKS=false