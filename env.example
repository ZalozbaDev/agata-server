# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb+srv://dummy:k28dKa0rtbMs9@cluster0.qorsvtn.mongodb.net/agata

# JWT Configuration (if needed later)
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d 
OPENAI_API_KEY=123

# Weather API Configuration
OPENWEATHER_API_KEY=8d2d1cab2dba3e179ea572dabcdf53db

# Data fetching settings
DATA_FETCH_INTERVAL=3600000  # 1 hour in milliseconds
DATA_RETENTION_DAYS=30

SOTRA_API_KEY=tajne...

# Twilio <-> Vosk bridge (optional)
VOSK_SERVER_URL=http://localhost:2700
# Audio sent to Vosk: default converts Twilio mulaw8k -> pcm16le (recommended)
# Set to 'mulaw8k' to forward raw Twilio bytes
VOSK_AUDIO_ENCODING=pcm16
# Target sample rate when using pcm16 conversion (your Vosk supports 8000 or 64000)
VOSK_TARGET_SAMPLE_RATE=8000

# Optional: save incoming Twilio audio to disk (disabled by default)
TWILIO_SAVE_AUDIO=false
# Also save converted PCM16LE (useful for Vosk debugging)
TWILIO_SAVE_AUDIO_PCM16=false
# Output directory (relative to server working dir unless absolute)
TWILIO_AUDIO_DIR=./twilio-audio

# When enabled, the server also writes a packet log of what is sent to Vosk:
# - vosk_packets.bin  (uint64le tsMs + uint32le bytes + audio bytes)
# - vosk_packets.jsonl (index: packet number, ts13, bytes)

# And a raw packet log of what comes from Twilio (boundary-preserving):
# - twilio_packets.bin  (uint64le tsMs + uint32le bytes + audio bytes)
# - twilio_packets.jsonl (index includes whether ts was synthetic)